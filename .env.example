# Copy to .env and configure locally. Never commit the real .env.
DATABASE_PASSWORD=
DATABASE_URL=jdbc:postgresql://localhost:5432/rag_note
DATABASE_USERNAME=rag_note
SERVER_PORT=8080
# Required only until the first administrator has been created.
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=
# OpenAI-compatible endpoints; chat and embedding can use different providers.
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=
CHAT_MODEL=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# The V1 schema uses vector(1024). The embedding provider must support 1024 dimensions.
# Set true behind your HTTPS reverse proxy; local HTTP uses false.
SESSION_COOKIE_SECURE=false
