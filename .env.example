# 将下面的变量填入 IDE 运行配置或启动环境。复制为 .env 时，需要由启动方式加载。
# 实际密码和 API Key 只填在本地环境中。

# PostgreSQL 连接
# 数据库密码，按本机或部署环境填写。
DATABASE_PASSWORD=
# JDBC 连接地址，默认连接本机 5432 端口的 rag_note 库。
DATABASE_URL=jdbc:postgresql://localhost:5432/rag_note
# PostgreSQL 登录账号。
DATABASE_USERNAME=rag_note

# 应用 HTTP 监听端口，默认 8080。
SERVER_PORT=8080
# 本地 HTTP 使用 false。正式部署走 HTTPS 时设置 true，登录 Cookie 仅通过 HTTPS 发送。
SESSION_COOKIE_SECURE=false

# 首次启动且库中还没有管理员时填写以下两项。
# 要创建的首个管理员用户名。
BOOTSTRAP_USERNAME=
# 要创建的首个管理员密码。
BOOTSTRAP_PASSWORD=

# 聊天模型，用于生成笔记问答和规划研究工具调用。
# OpenAI 兼容接口的基础地址，通常以 /v1 结尾。
CHAT_BASE_URL=https://api.openai.com/v1
# 聊天模型服务的 API Key。
CHAT_API_KEY=
# 供应商提供的聊天模型 ID。使用研究功能时，所选模型需支持工具调用。
CHAT_MODEL=

# Embedding 模型，用于将笔记分块和检索问题转换成向量。
# 可使用与聊天模型不同的供应商或服务地址。
EMBEDDING_BASE_URL=https://api.openai.com/v1
# Embedding 服务的 API Key。
EMBEDDING_API_KEY=
# 供应商提供的 Embedding 模型 ID，需能返回 1024 维向量。
EMBEDDING_MODEL=

# 二期研究默认关闭。设为 true 后可查本人笔记。
# 读取公开网页时，请求需传 allowWeb=true 和明确的 webUrls。
RESEARCH_ENABLED=false
